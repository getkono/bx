# Generated by bx. This fixture carries bx's *own* contribution only — the
# staleness check and bx's completion registration. Cached tool activations are
# measured separately by the legacy/generated pair, because those replace work
# the user was already paying for.

# Staleness: one builtin test, two stats, no subprocess. Set when the snippet is
# older than the binary that generated it; the prompt surfaces it once.
[[ ${BX_BIN:=${commands[bx]:-/nonexistent}} -nt ${BX_INIT} ]] && typeset -g BX_STALE=1

# bx's own dynamic completion. Registration is a single autoload; `bx __complete`
# is spawned only when the user actually presses Tab.
_bx() {
  local -a candidates
  candidates=("${(@f)$(bx __complete "${words[@]}")}")
  compadd -- $candidates
}
compdef _bx bx 2>/dev/null
