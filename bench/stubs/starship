#!/bin/sh
# Stand-in for starship: emits an init block of representative size, then exits.
# The process spawn is the point — it is what `eval "\$(starship init zsh)"` costs.
#
# Like the real tool, the block ends by setting the continuation prompt through
# a command substitution that runs this program again, at its absolute path, so
# every start that sources the cached block spawns one process, as a start with
# the real starship does. `starship prompt --continuation` answers it, and
# spawns nothing more of its own.
set -eu
case "${1-}" in
prompt)
	printf '%s' '> '
	exit 0
	;;
esac
here="$(cd "$(dirname "$0")" && pwd)"
"${here}/gen.sh" starship 20
case "${2-}" in
bash) printf '%s\n' "PS2=\"\$('${here}/starship' prompt --continuation)\"" ;;
*) printf '%s\n' "PROMPT2=\"\$('${here}/starship' prompt --continuation)\"" ;;
esac
