#!/bin/sh
# line-check — no tracked file may grow past LIMIT lines, and LIMIT only falls.
#
#   scripts/line-check [BASE]
#
# Counts the lines of every git-tracked text file in the working tree, outside
# tests/fixtures/ (captured third-party output nobody edits) and Cargo.lock
# (generated). A file over LIMIT fails the check unless its path is listed in
# scripts/line-check-baseline. That list may only shrink, and LIMIT may only
# fall, so the check also fails when:
#
#   - a listed path is no longer over LIMIT (or no longer exists): delete its
#     line, so the file cannot quietly grow back;
#   - LIMIT is above BASE's LIMIT;
#   - the list holds a path BASE's list does not. The one exception is a LIMIT
#     below BASE's: a path BASE already held over the new LIMIT may then join
#     the list. Lowering the limit is the only way an entry is added, and a
#     file grown onto the list still fails.
#
# BASE defaults to origin/HEAD. When it does not resolve, the comparisons with
# it are skipped and the script says so, as it does for a BASE that holds no
# baseline or no LIMIT yet.
#
# The baseline holds paths, not counts, so a listed file shrinking or growing
# under its entry never churns the list. Lines starting with `#` and blank
# lines are ignored; the paths must be sorted (LC_ALL=C) and unique.

set -eu

LIMIT=2153
SCRIPT=scripts/line-check
BASELINE=scripts/line-check-baseline

cd "$(git rev-parse --show-toplevel)"

fail=0
problem() {
	printf 'line-check: %s\n' "$1" >&2
	fail=1
}

note() {
	printf 'line-check: %s\n' "$1" >&2
}

# Total lines read from stdin, counting a final line with no newline.
lines() {
	awk 'END { print NR }'
}

# Paths listed in a baseline read from stdin.
entries() {
	grep -v -e '^#' -e '^[[:space:]]*$' || true
}

# Lines of list $1 that list $2 does not hold.
missing() {
	printf '%s\n' "$1" | while IFS= read -r path; do
		[ -n "$path" ] || continue
		printf '%s\n' "$2" | grep -Fxq -- "$path" || printf '%s\n' "$path"
	done
}

# Print each line of $1 as an error through format $2, and fail if there is one.
report() {
	[ -n "$1" ] || return 0
	fail=1
	while IFS= read -r path; do
		# shellcheck disable=SC2059 # the format is this script's own constant
		printf "line-check: $2\n" "$path" >&2
	done <<EOF
$1
EOF
}

# Tracked text files outside the exclusions that are over LIMIT, sorted. Paths
# travel NUL-terminated, so git quotes none of them. `--eol` marks a binary in
# the index as `i/-text`, and the path follows the entry's first tab. Each path
# reaches awk as `./PATH`, so one holding `=` is a file to awk, not an
# assignment.
# shellcheck disable=SC2016 # the inner sh expands the program, not this one
over=$(git ls-files -z --eol -- . ':!:tests/fixtures/' ':!:Cargo.lock' |
	xargs -0 sh -c '
		for entry do
			case $entry in i/-text*) continue ;; esac
			path=${entry#*	}
			if [ -f "$path" ] && [ ! -L "$path" ]; then
				printf "./%s\0" "$path"
			fi
		done
	' sh |
	xargs -0 awk -v limit="$LIMIT" '
		{ n[FILENAME]++ }
		END { for (f in n) if (n[f] > limit) print substr(f, 3) }
	' |
	LC_ALL=C sort)

if [ -f "$BASELINE" ]; then
	listed=$(entries <"$BASELINE")
else
	listed=
fi

if [ "$listed" != "$(printf '%s\n' "$listed" | LC_ALL=C sort -u)" ]; then
	problem "$BASELINE must be sorted (LC_ALL=C) with no repeated path"
fi

# A file over LIMIT that the baseline does not excuse.
unlisted=$(missing "$over" "$listed")
if [ -n "$unlisted" ]; then
	fail=1
	while IFS= read -r path; do
		printf 'line-check: %s has %s lines, over the %s-line limit; split it\n' \
			"$path" "$(lines <"$path")" "$LIMIT" >&2
	done <<EOF
$unlisted
EOF
fi

# A baseline entry the file no longer needs.
report "$(missing "$listed" "$over")" \
	"%s is no longer over $LIMIT lines; delete it from $BASELINE"

# Lines of list $1 that BASE does not admit to the baseline: a path joins it
# only when LIMIT fell below BASE's and BASE already held the path over LIMIT.
unadmitted() {
	printf '%s\n' "$1" | while IFS= read -r path; do
		[ -n "$path" ] || continue
		if [ -n "$base_limit" ] && [ "$LIMIT" -lt "$base_limit" ] &&
			git cat-file -e "$base:$path" 2>/dev/null &&
			[ "$(git show "$base:$path" | lines)" -gt "$LIMIT" ]; then
			continue
		fi
		printf '%s\n' "$path"
	done
}

# LIMIT and the baseline, against BASE's.
base=${1-}
if [ -z "$base" ] && git rev-parse -q --verify origin/HEAD >/dev/null; then
	base=origin/HEAD
fi
if [ -z "$base" ]; then
	note "no base to compare LIMIT and $BASELINE against; neither checked"
elif ! git rev-parse -q --verify "$base^{commit}" >/dev/null; then
	problem "base $base does not resolve to a commit"
else
	base_limit=$(git show "$base:$SCRIPT" 2>/dev/null |
		sed -n 's/^LIMIT=\([0-9][0-9]*\)$/\1/p' | head -n 1)
	if [ -z "$base_limit" ]; then
		note "$base has no LIMIT in $SCRIPT yet; LIMIT not checked"
	elif [ "$LIMIT" -gt "$base_limit" ]; then
		problem "LIMIT is $LIMIT, above $base's $base_limit; the limit only goes down"
	fi
	if ! git cat-file -e "$base:$BASELINE" 2>/dev/null; then
		note "$base has no $BASELINE yet; growth not checked"
	else
		before=$(git show "$base:$BASELINE" | entries)
		report "$(unadmitted "$(missing "$listed" "$before")")" \
			"$BASELINE gained %s, which $base does not list; only lowering LIMIT adds an entry, for a file $base already held over it"
	fi
fi

if [ "$fail" = 0 ]; then
	printf 'line-check: no file newly over %s lines\n' "$LIMIT"
fi
exit "$fail"
