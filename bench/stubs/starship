#!/bin/sh
# Stand-in for starship: emits an init block of representative size, then exits.
# The process spawn is the point — it is what `eval "\$(starship init zsh)"` costs.
#
# Like the real tool, the block ends by setting the continuation prompt through
# a command substitution that runs starship again, at its absolute path, so
# every start that sources the cached block spawns one process, as a start with
# the real starship does. `starship prompt --continuation` answers it, and
# spawns nothing more of its own. The path is the starship PATH finds: the
# bench puts the native starship.c there, which hands every other command to
# this script, so a start pays for a native program as it does with the real
# one, not for starting /bin/sh.
#
# With BX_BENCH_CAPTURED naming tests/fixtures/activation, `starship init zsh`
# prints the real tool's captured output instead, with that same starship in
# place of the capturing machine's. Its prompts then start starship at every
# prompt, as the real ones do, and starship.c answers them.
set -eu
case "${1-}" in
prompt)
	printf '%s' '> '
	exit 0
	;;
esac
here="$(cd "$(dirname "$0")" && pwd)"
self="$(command -v starship)" || self="${here}/starship"
if [ -n "${BX_BENCH_CAPTURED-}" ] && [ "${2-}" = zsh ]; then
	exec sed "s|/bin/starship|${self}|g" "${BX_BENCH_CAPTURED}/starship-init-zsh.zsh"
fi
"${here}/gen.sh" starship 20
case "${2-}" in
bash) printf '%s\n' "PS2=\"\$('${self}' prompt --continuation)\"" ;;
*) printf '%s\n' "PROMPT2=\"\$('${self}' prompt --continuation)\"" ;;
esac
